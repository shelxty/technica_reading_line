{
  "manifest_version": 3,
  "name": "Wavy – Read the web with your hands",
  "version": "2.0.0",
  "description": "Point to move, two fingers to highlight, thumbs up to hear the line, palm to scroll, pinch to click and zoom.",
  "permissions": ["offscreen", "storage", "scripting", "tabs", "tts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wavy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gestures.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-tracking": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Start / stop hand tracking"
    },
    "toggle-sleep": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Sleep / wake gestures (same as waving)"
    },
    "read-here": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read the highlighted line, or the line under the mouse (press again to stop)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
